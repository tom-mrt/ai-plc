---
import Layout from "../components/Layout.astro";
---

<Layout title="Meishi Coffee">
  <section class="mx-auto max-w-3xl">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="badge badge-primary">Coffee homepage MVP</div>
        <h1 class="card-title text-3xl">Meishi Coffee</h1>
        <p>好きなコーヒー、お店、記録をまとめる小さなホームページです。</p>
        <div class="card-actions justify-end">
          <a class="btn btn-primary" href="/coffee/">Coffee Logを見る</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
